    },
    {
      "id": "zeroOrderHold",
      "slx": "ZeroOrderHold",
      "label": "Zero-Order Hold",
      "parameters": [
        {
          "name": "SampleTime",
          "label": "采样时间",
          "group": "execution",
          "editor": "expression",
          "path": "sampleTime",
          "shape": "sampleTime",
          "defaultValue": "-1",
          "help": "-1 继承，0 连续，inf 常量；正数指定周期（秒）。也支持 [Ts 0]，暂不支持非零偏移。"
        }
      ]
    },
    {
      "id": "transferFcn",
      "slx": "TransferFcn",
      "label": "Transfer Fcn",
