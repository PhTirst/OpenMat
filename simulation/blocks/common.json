          "name": "ControlSampleTime",
          "label": "控制采样周期",
          "group": "execution",
          "editor": "expression",
          "path": "controlPeriod",
          "shape": "scalar",
          "defaultValue": "0.1",
          "extension": true,
          "help": "OpenMat 当前按显式离散周期检测边沿（秒）。"
        }
      ]
