        {
          "name": "Denominator",
          "label": "分母系数",
          "group": "main",
          "editor": "expression",
          "path": "kind.operation.denominator",
          "shape": "vector",
          "defaultValue": "[1 1]"
        }
      ]
    },
    {
      "id": "stateSpace",
      "slx": "StateSpace",
