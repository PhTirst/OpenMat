    },
    {
      "id": "mux",
      "slx": "Mux",
      "label": "Mux",
      "parameters": [
        {
          "name": "Inputs",
          "label": "输入端口数量",
          "group": "main",
          "editor": "expression",
          "path": "kind.operation.inputs",
          "shape": "count",
          "defaultValue": "2"
        },
        {
          "name": "SampleTime",
          "label": "采样时间",
