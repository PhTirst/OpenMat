        {
          "name": "ExternalReset",
          "label": "外部复位",
          "group": "main",
          "editor": "choice",
          "path": "externalReset",
          "defaultValue": "none",
          "options": [
            {
              "value": "none",
              "supported": true
            },
            {
              "value": "rising",
              "supported": true
            },
            {
              "value": "falling",
              "supported": true
            },
            {
              "value": "either",
              "supported": true
            },
            {
              "value": "level",
              "supported": false
            },
            {
              "value": "level hold",
              "supported": false
            }
          ]
        },
        {
          "name": "InitialConditionSource",
          "label": "初始条件来源",
          "group": "main",
          "editor": "choice",
          "defaultValue": "internal",
          "fixed": "internal",
          "options": [
            {
              "value": "internal",
              "supported": true
            },
            {
              "value": "external",
              "supported": false
            }
          ]
        },
        {
          "name": "LimitOutput",
          "label": "限制输出",
          "group": "main",
          "editor": "choice",
          "defaultValue": "off",
          "fixed": "off",
          "options": [
            {
              "value": "off",
              "supported": true
            },
            {
              "value": "on",
              "supported": false
            }
          ]
        },
        {
          "name": "SampleTime",
          "label": "采样时间",
          "group": "execution",
          "editor": "expression",
          "path": "sampleTime",
          "shape": "sampleTime",
          "defaultValue": "-1",
          "help": "-1 继承，0 连续，inf 常量；正数指定周期（秒）。也支持 [Ts 0]，暂不支持非零偏移。"
        }
      ]
    },
    {
      "id": "unitDelay",
      "slx": "UnitDelay",
      "label": "Unit Delay",
      "parameters": [
        {
          "name": "InitialCondition",
          "label": "初始条件",
          "group": "main",
          "editor": "expression",
          "path": "kind.initial",
          "shape": "vector",
          "defaultValue": "0"
        },
        {
          "name": "SampleTime",
          "label": "采样时间",
          "group": "execution",
          "editor": "expression",
          "path": "sampleTime",
          "shape": "sampleTime",
          "defaultValue": "-1",
          "help": "-1 继承，0 连续，inf 常量；正数指定周期（秒）。也支持 [Ts 0]，暂不支持非零偏移。"
