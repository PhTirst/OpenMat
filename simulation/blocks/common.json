          "label": "输出宽度",
          "group": "main",
          "editor": "expression",
          "path": "kind.operation.widths",
          "shape": "widths",
          "defaultValue": "[1 1]",
          "help": "为各输出指定宽度，例如 [2 3]。"
        },
        {
          "name": "SampleTime",
          "label": "采样时间",
          "group": "execution",
          "editor": "expression",
          "path": "sampleTime",
          "shape": "sampleTime",
          "defaultValue": "-1",
          "help": "-1 继承，0 连续，inf 常量；正数指定周期（秒）。也支持 [Ts 0]，暂不支持非零偏移。"
        }
      ]
    },
    {
      "id": "step",
      "slx": "Step",
      "label": "Step",
      "parameters": [
        {
          "name": "Time",
          "label": "阶跃时间",
          "group": "main",
          "editor": "expression",
          "path": "kind.time",
          "shape": "scalar",
          "defaultValue": "1"
        },
        {
          "name": "Before",
          "label": "初始值",
          "group": "main",
          "editor": "expression",
          "path": "kind.before",
          "shape": "vector",
          "defaultValue": "0"
        },
        {
          "name": "After",
          "label": "最终值",
          "group": "main",
          "editor": "expression",
          "path": "kind.after",
          "shape": "vector",
          "defaultValue": "1"
        },
        {
          "name": "SampleTime",
          "label": "采样时间",
          "group": "execution",
          "editor": "expression",
          "path": "sampleTime",
          "shape": "sampleTime",
          "defaultValue": "-1",
          "help": "-1 继承，0 连续，inf 常量；正数指定周期（秒）。也支持 [Ts 0]，暂不支持非零偏移。"
        }
      ]
    },
    {
      "id": "inport",
      "slx": "Inport",
      "label": "Inport",
      "parameters": [
        {
          "name": "Port",
          "label": "端口编号",
          "group": "main",
          "editor": "readonly",
          "path": "kind.port",
          "defaultValue": "1",
          "help": "当前随同层端口增删自动编号。"
        }
      ]
    },
    {
      "id": "outport",
      "slx": "Outport",
      "label": "Outport",
      "parameters": [
        {
          "name": "Port",
          "label": "端口编号",
          "group": "main",
          "editor": "readonly",
          "path": "kind.port",
          "defaultValue": "1"
        },
        {
          "name": "InitialOutput",
          "label": "初始输出",
          "group": "main",
          "editor": "expression",
          "path": "initialOutput",
          "shape": "vector",
          "defaultValue": "[]",
          "conditional": true,
          "help": "当前需要显式有限初值；[] 继承初值尚未支持。"
        },
        {
          "name": "OutputWhenDisabled",
          "label": "禁用时的输出",
          "group": "main",
          "editor": "choice",
          "path": "outputWhenDisabled",
          "defaultValue": "held",
          "conditional": true,
          "options": [
            {
              "value": "held",
              "supported": true
            },
            {
              "value": "reset",
              "supported": true
            }
          ]
        }
      ]
    },
    {
      "id": "enabled",
      "slx": "EnablePort",
      "label": "Enable",
      "parameters": [
        {
          "name": "StatesWhenEnabling",
          "label": "重新启用时的状态",
          "group": "main",
          "editor": "choice",
          "path": "statesWhenEnabling",
          "defaultValue": "held",
          "options": [
            {
              "value": "held",
              "supported": true
            },
            {
              "value": "reset",
              "supported": true
            }
          ]
        },
        {
          "name": "ControlSampleTime",
          "label": "控制采样周期",
          "group": "execution",
          "editor": "expression",
          "path": "controlPeriod",
          "shape": "scalar",
          "defaultValue": "0.1",
          "extension": true,
          "help": "OpenMat 当前按显式离散周期检查控制信号（秒）。"
        }
      ]
    },
    {
      "id": "triggered",
      "slx": "TriggerPort",
