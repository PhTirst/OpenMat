{
  "schemaVersion": 1,
  "name": "First-order feedback: x' = 1 - x",
  "settings": { "startTime": 0.0, "stopTime": 1.0, "maxStep": 0.05 },
  "blocks": [
    { "id": "one", "kind": { "type": "constant", "value": [1.0] } },
    { "id": "sum", "kind": { "type": "sum", "signs": [1, -1] } },
    { "id": "gain", "kind": { "type": "gain", "gain": [1.0] } },
    { "id": "state", "kind": { "type": "integrator", "initial": [0.0] } },
    { "id": "scope", "kind": { "type": "scope" } }
  ],
  "connections": [
    { "from": { "block": "one", "port": "out" }, "to": { "block": "sum", "port": "in0" } },
    { "from": { "block": "gain", "port": "out" }, "to": { "block": "sum", "port": "in1" } },
    { "from": { "block": "state", "port": "out" }, "to": { "block": "gain", "port": "in" } },
    { "from": { "block": "sum", "port": "out" }, "to": { "block": "state", "port": "in" } },
    { "from": { "block": "state", "port": "out" }, "to": { "block": "scope", "port": "in" } }
  ]
}
