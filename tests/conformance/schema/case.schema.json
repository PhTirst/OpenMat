{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmat.dev/schema/conformance-case-v1.json",
  "title": "OpenMat conformance case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "description", "source", "tags", "expected"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "description": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "pattern": "^programs/[A-Za-z0-9_.-]+\\.m$" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "expected": { "$ref": "#/$defs/expected" }
  },
  "$defs": {
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "value"],
          "properties": {
            "outcome": { "const": "ok" },
            "value": { "$ref": "#/$defs/value" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "error"],
          "properties": {
            "outcome": { "const": "error" },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category"],
              "properties": {
                "category": {
                  "enum": [
                    "access-violation",
                    "arity",
                    "assertion-failed",
                    "dimension-mismatch",
                    "index-out-of-bounds",
                    "syntax-error",
                    "type-error",
                    "undefined-name",
                    "other"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "value": {
      "type": "object",
      "required": ["class", "size", "ndims", "numel", "kind"],
      "properties": {
        "class": { "type": "string" },
        "size": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "integer", "minimum": 0 }
        },
        "ndims": { "type": "integer", "minimum": 2 },
        "numel": { "type": "integer", "minimum": 0 },
        "kind": {
          "enum": ["numeric", "integer", "logical", "char", "string", "cell", "struct", "object"]
        },
        "real": { "$ref": "#/$defs/numberStrings" },
        "imag": { "$ref": "#/$defs/numberStrings" },
        "integer": { "type": "array", "items": { "type": "string" } },
        "logical": { "type": "array", "items": { "type": "boolean" } },
        "code_units": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "string": { "type": "array", "items": { "type": "string" } },
        "missing": { "type": "array", "items": { "type": "boolean" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/value" } },
        "tolerance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "absolute": { "type": "number", "minimum": 0 },
            "relative": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "numberStrings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(NaN|[+-]Inf|-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?)$"
      }
    }
  }
}
