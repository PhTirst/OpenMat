{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openmat.dev/schema/conformance-case-v2.json",
  "title": "OpenMat conformance case version 2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "description", "source", "tags", "expected"],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "description": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "pattern": "^programs/[A-Za-z0-9_.-]+\\.m$" },
    "tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "expected": { "$ref": "#/$defs/expected" }
  },
  "$defs": {
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decimalInteger": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$"
    },
    "unsignedDecimalInteger": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "integerComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["real", "imaginary"],
      "properties": {
        "real": { "$ref": "#/$defs/decimalInteger" },
        "imaginary": { "$ref": "#/$defs/decimalInteger" }
      }
    },
    "unsignedIntegerComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["real", "imaginary"],
      "properties": {
        "real": { "$ref": "#/$defs/unsignedDecimalInteger" },
        "imaginary": { "$ref": "#/$defs/unsignedDecimalInteger" }
      }
    },
    "numberString": {
      "type": "string",
      "pattern": "^(NaN|[+-]Inf|-?(0|[1-9][0-9]*)(\\.[0-9]+)?([eE][+-]?[0-9]+)?)$"
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "absolute": { "type": "number", "minimum": 0 },
        "relative": { "type": "number", "minimum": 0 }
      }
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "value"],
          "properties": {
            "outcome": { "const": "ok" },
            "value": { "$ref": "#/$defs/value" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "error"],
          "properties": {
            "outcome": { "const": "error" },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": ["category"],
              "properties": {
                "category": {
                  "enum": [
                    "access-violation",
                    "arity",
                    "assertion-failed",
                    "dimension-mismatch",
                    "index-out-of-bounds",
                    "syntax-error",
                    "type-error",
                    "undefined-name",
                    "other"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "value": {
      "description": "After structural validation, the v2 runner validates the complete recursive value in depth-first pre-order. It checks canonical metadata and payload counts, column-major cell items and struct records, ordered ASCII struct fields, exact record field sets, ordered table variable names and complete variables, integer ranges, string missing bits, and the schema-v2 node, element, depth, UTF-16, per-node, per-string, and encoded-size limits. Exact values are complete and cannot contain truncation metadata.",
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "size", "ndims", "numel", "complex", "kind"],
      "properties": {
        "class": { "type": "string", "minLength": 1 },
        "size": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/safeInteger" }
        },
        "ndims": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "numel": { "$ref": "#/$defs/safeInteger" },
        "complex": { "type": "boolean" },
        "kind": {
          "enum": [
            "numeric",
            "integer",
            "logical",
            "char",
            "string",
            "cell",
            "struct",
            "table",
            "object"
          ]
        },
        "real": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/numberString" }
        },
        "imag": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/numberString" }
        },
        "integer": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/integerComponent" }
        },
        "logical": {
          "type": "array",
          "maxItems": 4096,
          "items": { "type": "boolean" }
        },
        "code_units": {
          "type": "array",
          "maxItems": 4096,
          "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
        },
        "string_code_units": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "array",
            "maxItems": 16384,
            "items": { "type": "integer", "minimum": 0, "maximum": 65535 }
          }
        },
        "missing": {
          "type": "array",
          "maxItems": 4096,
          "items": { "type": "boolean" }
        },
        "items": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/value" }
        },
        "fields": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "records": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/value" }
          }
        },
        "variableNames": {
          "type": "array",
          "maxItems": 16383,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "variables": {
          "type": "array",
          "maxItems": 16383,
          "items": { "$ref": "#/$defs/value" }
        },
        "tolerance": { "$ref": "#/$defs/tolerance" }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "numeric" },
            "class": { "enum": ["double", "single"] }
          },
          "required": ["real", "imag"],
          "not": {
            "anyOf": [
              { "required": ["integer"] },
              { "required": ["logical"] },
              { "required": ["code_units"] },
              { "required": ["string_code_units"] },
              { "required": ["missing"] },
              { "required": ["items"] },
              { "required": ["fields"] },
              { "required": ["records"] }
            ]
          },
          "if": {
            "properties": { "complex": { "const": false } },
            "required": ["complex"]
          },
          "then": {
            "properties": {
              "imag": { "items": { "const": "0" } }
            }
          }
        },
        {
          "properties": {
            "kind": { "const": "integer" },
            "class": {
              "enum": [
                "int8",
                "uint8",
                "int16",
                "uint16",
                "int32",
                "uint32",
                "int64",
                "uint64"
              ]
            }
          },
          "required": ["integer"],
          "not": {
            "anyOf": [
              { "required": ["real"] },
              { "required": ["imag"] },
              { "required": ["logical"] },
              { "required": ["code_units"] },
              { "required": ["string_code_units"] },
              { "required": ["missing"] },
              { "required": ["items"] },
              { "required": ["fields"] },
              { "required": ["records"] },
              { "required": ["tolerance"] }
            ]
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "class": { "enum": ["uint8", "uint16", "uint32", "uint64"] }
                },
                "required": ["class"]
              },
              "then": {
                "properties": {
                  "integer": {
                    "items": { "$ref": "#/$defs/unsignedIntegerComponent" }
                  }
                }
              }
            },
            {
              "if": {
                "properties": { "complex": { "const": false } },
                "required": ["complex"]
              },
              "then": {
                "properties": {
                  "integer": {
                    "items": {
                      "type": "object",
                      "properties": { "imaginary": { "const": "0" } },
                      "required": ["imaginary"]
                    }
                  }
                }
              },
              "else": {
                "properties": {
                  "integer": {
                    "contains": {
                      "type": "object",
                      "properties": {
                        "imaginary": { "pattern": "^-?[1-9][0-9]*$" }
                      },
                      "required": ["imaginary"]
                    },
                    "minContains": 1
                  }
                }
              }
            }
          ]
        },
        {
          "properties": {
            "kind": { "const": "logical" },
            "class": { "const": "logical" },
            "complex": { "const": false }
          },
          "required": ["logical"],
          "not": {
            "anyOf": [
              { "required": ["real"] },
              { "required": ["imag"] },
              { "required": ["integer"] },
              { "required": ["code_units"] },
              { "required": ["string_code_units"] },
              { "required": ["missing"] },
              { "required": ["items"] },
              { "required": ["fields"] },
              { "required": ["records"] },
              { "required": ["tolerance"] }
            ]
          }
        },
        {
          "properties": {
            "kind": { "const": "char" },
            "class": { "const": "char" },
            "complex": { "const": false }
          },
          "required": ["code_units"],
          "not": {
            "anyOf": [
              { "required": ["real"] },
              { "required": ["imag"] },
              { "required": ["integer"] },
              { "required": ["logical"] },
              { "required": ["string_code_units"] },
              { "required": ["missing"] },
              { "required": ["items"] },
              { "required": ["fields"] },
              { "required": ["records"] },
              { "required": ["tolerance"] }
            ]
          }
        },
        {
          "properties": {
            "kind": { "const": "string" },
            "class": { "const": "string" },
            "complex": { "const": false }
          },
          "required": ["string_code_units", "missing"],
          "not": {
            "anyOf": [
              { "required": ["real"] },
              { "required": ["imag"] },
              { "required": ["integer"] },
              { "required": ["logical"] },
              { "required": ["code_units"] },
              { "required": ["items"] },
              { "required": ["fields"] },
              { "required": ["records"] },
              { "required": ["tolerance"] }
            ]
          }
        },
        {
          "properties": {
            "kind": { "const": "cell" },
            "class": { "const": "cell" },
            "complex": { "const": false }
          },
          "required": ["items"],
          "not": {
            "anyOf": [
              { "required": ["real"] },
              { "required": ["imag"] },
              { "required": ["integer"] },
              { "required": ["logical"] },
              { "required": ["code_units"] },
              { "required": ["string_code_units"] },
              { "required": ["missing"] },
              { "required": ["fields"] },
              { "required": ["records"] },
              { "required": ["tolerance"] }
            ]
          }
        },
        {
          "properties": {
            "kind": { "const": "struct" },
            "class": { "const": "struct" },
            "complex": { "const": false },
            "fields": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
              }
            },
            "records": {
              "type": "array",
              "maxItems": 4096,
              "items": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "additionalProperties": { "$ref": "#/$defs/value" }
              }
            }
          },
          "required": ["fields", "records"],
          "not": {
            "anyOf": [
              { "required": ["real"] },
              { "required": ["imag"] },
              { "required": ["integer"] },
              { "required": ["logical"] },
              { "required": ["code_units"] },
              { "required": ["string_code_units"] },
              { "required": ["missing"] },
              { "required": ["items"] },
              { "required": ["tolerance"] }
            ]
          }
        },
        {
          "properties": {
            "kind": { "const": "table" },
            "class": { "const": "table" },
            "complex": { "const": false },
            "size": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/safeInteger" }
            },
            "ndims": { "const": 2 }
          },
          "required": ["variableNames", "variables"],
          "not": {
            "anyOf": [
              { "required": ["real"] },
              { "required": ["imag"] },
              { "required": ["integer"] },
              { "required": ["logical"] },
              { "required": ["code_units"] },
              { "required": ["string_code_units"] },
              { "required": ["missing"] },
              { "required": ["items"] },
              { "required": ["fields"] },
              { "required": ["records"] },
              { "required": ["tolerance"] }
            ]
          }
        },
        {
          "properties": {
            "kind": { "const": "object" },
            "complex": { "const": false }
          },
          "dependentRequired": {
            "fields": ["records"],
            "records": ["fields"]
          },
          "not": {
            "anyOf": [
              { "required": ["real"] },
              { "required": ["imag"] },
              { "required": ["integer"] },
              { "required": ["logical"] },
              { "required": ["code_units"] },
              { "required": ["string_code_units"] },
              { "required": ["missing"] },
              { "required": ["items"] },
              { "required": ["tolerance"] }
            ]
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "table" } },
            "required": ["kind"]
          },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["variableNames"] },
                { "required": ["variables"] }
              ]
            }
          }
        }
      ]
    }
  }
}
