{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenMat",
  "mainBinaryName": "OpenMat",
  "version": "0.1.4",
  "identifier": "org.openmat.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../web dev:ready",
    "beforeBuildCommand": "pnpm --dir ../web build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "DeveloperTool",
    "shortDescription": "OpenMat numerical computing environment",
    "useLocalToolsDir": true,
    "resources": [
      "resources/openblas/libopenblas.dll",
      "resources/licenses/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English", "SimpChinese"],
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
