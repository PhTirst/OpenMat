{
  "name": "@openmat/web",
  "private": true,
  "version": "0.1.0-alpha.0",
  "type": "module",
  "scripts": {
    "build:plot-wasm": "node ./scripts/build-plot-wasm.mjs",
    "build:plot-wasm:debug": "node ./scripts/build-plot-wasm.mjs --debug",
    "build:plot-wasm:release": "node ./scripts/build-plot-wasm.mjs --release",
    "dev": "pnpm build:plot-wasm && vite",
    "dev:ready": "vite",
    "build": "pnpm build:plot-wasm:release && tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@tauri-apps/api": "2.11.1",
    "katex": "0.18.4",
    "monaco-editor": "0.52.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  },
